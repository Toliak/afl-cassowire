# Default configuration for afl-cassowire
# Copy this to config.yaml and adjust values as needed.

target:
  binary: "./src/build/afl-clang-fast/tinynginx"           # Path to the target binary (required)
  args: ["tinynginx", "-p", "8060"]                     # Additional arguments (binary is added automatically)
  env:
    WORKERS: 1

  # log:
  #   stdout: ""                 # Redirect target stdout to this file (optional)
  #   stderr: ""                 # Redirect target stderr to this file (optional)

target_cmplog:
  binary: "./src/build/afl-clang-fast_cmplog/tinynginx"           # Path to the compare-mode target binary (required)
  args: ["tinynginx", "-p", "9060"]                     # Additional arguments (binary is added automatically)
  env:
    WORKERS: 1

network: &network
  host: "127.0.0.1"            # TCP host to connect to
  port: 8060                   # Port to connect to (1-65535, required)
  timeout_ms: 100              # Network send/recv timeout in milliseconds
  initial_ms: 200              # Port detection timeout in milliseconds

  probe: true
  probe_retry_ms: 10
  probe_attempts: 3

network_cmplog: 
  <<: *network
  port: 9060                   # Port to connect to (1-65535, required)

afl:
  loop_count: 20000            # Number of __AFL_LOOP iterations
  enable_cmplog: true         # Enable AFL compare log (requires __AFL_CMPLOG_SHM_ID)

port_detection:
  primary: "procfs"            # Method: "procfs", "ptrace", or "seccomp"
  # primary: "ptrace"            # Method: "procfs", "ptrace", or "seccomp"
  # primary: "seccomp"            # Method: "procfs", "ptrace", or "seccomp"
  # defork: true
  
  verify_ownership: true

# cleanup:
#  force_kill_ms: 150          # Wait time after SIGTERM before SIGKILL
#  kill_pattern: "tinynginx"               # Optional: auto-kill stale target processes
    # Scalar form — matches /proc/<pid>/comm:
    # "nginx"
    #
    # Object form — explicit match:
    # type: comm                   # or "regexp"
    # value: "nginx"
    # target: "comm"              # or "argv0", "argv"

payload:
  suffix: "\r\n\r\n"
