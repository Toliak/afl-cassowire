+
+#ifdef AFL_PERSISTENT_PATCH
+
+__AFL_FUZZ_INIT();
+
+int main(int argc, char* argv[]) {
+    (void)argc;
+    (void)argv;
+
+    /* Create a minimal public directory for path resolution tests.
+     * In a real setup, you'd pre-populate this with test files. */
+    (void)mkdir(PUBLIC_DIR, 0755);
+
+#ifdef __AFL_HAVE_MANUAL_CONTROL
+    /* Deferred forkserver: initialize AFTER we've done any one-time setup,
+     * but BEFORE we enter the hot loop. */
+    __AFL_INIT();
+#endif
+
+    /* Shared memory fuzzing: get pointer to AFL++'s input buffer */
+    unsigned char *buf = __AFL_FUZZ_TESTCASE_BUF;
+
+    while (__AFL_LOOP(10000)) {
+        int len = __AFL_FUZZ_TESTCASE_LEN;
+
+        /* Skip empty inputs */
+        if (len < 1) continue;
+
+        /* Allocate and reset client state for each iteration.
+         * This is CRITICAL for persistent mode: every iteration must
+         * start from a clean state to avoid false positives and
+         * stability degradation. */
+        HTTPClient* client = http_client_init(-1, CLIENT_RECEIVING_REQUEST);
+        if (!client) continue;
+
+        /* Copy fuzz input into the client's request buffer.
+         * Ensure null-termination and respect buffer limits. */
+        size_t copy_len = (size_t)len < (MAX_CLIENT_REQUEST_BUFFER - 1)
+                          ? (size_t)len
+                          : (MAX_CLIENT_REQUEST_BUFFER - 1);
+
+        memcpy(client->request, buf, copy_len);
+        client->request[copy_len] = '\0';
+        client->request_len = copy_len;
+
+        /* Only parse if we have a complete HTTP request (ends with \r\n\r\n)
+         * OR if the input is large enough to be interesting.
+         * This mimics the real receive_request() logic. */
+        if (strstr(client->request, "\r\n\r\n") != NULL ||
+            copy_len >= MAX_CLIENT_REQUEST_BUFFER - 2) {
+
+            /* Call the function under test */
+            parse_http_request(client);
+        }
+
+        /* =========================================================================
+         * STATE RESET: Clean up any resources allocated during parsing.
+         * ========================================================================= */
+        if (client->file_fd != -1) {
+            close(client->file_fd);
+        }
+
+        /* Free the client - this prevents memory leaks across iterations */
+        free(client);
+    }
+
+    return 0;
+}
+
+#endif  //AFL_PERSISTENT_PATCH
