@@ -89,11 +89,94 @@ static const u8 count_class_lookup8[256] = {
 /* new_bits layout used by save_if_interesting()/describe_op().
    - low 2 bits: coverage novelty class from has_new_bits() (0,1,2)
    - 3rd bit: value-profile-only queue save marker
+   - 4th bit: instability-gate-only queue save marker
    - 8th bit: timeout marker */
 #define NEW_BITS_COVERAGE_MASK 0x03
 #define NEW_BITS_VP_MASK 0x04
+#define NEW_BITS_STAB_MASK 0x08
 #define NEW_BITS_TIMEOUT_MASK 0x80
 
+/* Instability-aware coverage admission (AFL_STAB_ADMIT=repro).
+   Called when an execution produced no new stable coverage but hit edges that
+   calibration retired as variable. The input is re-executed stab_repro_runs
+   times; the edges that reproduce on *every* run (the reproducible core of the
+   unstable novelty) are claimed in the presence-only unstable channel and the
+   input is admitted to the queue. If nothing reproduces, the candidate is
+   rejected and nothing is claimed, so a later execution can try again. */
+static u8 stab_repro_admit(afl_state_t *afl, void *mem, u32 len) {
+
+  u32 n = 0, i;
+
+  memset(afl->stab_cand, 0, afl->fsrv.map_size);
+  for (i = 0; i < afl->fsrv.map_size; ++i) {
+
+    if (afl->fsrv.trace_bits[i] && afl->virgin_unstable[i]) {
+
+      afl->stab_cand[i] = 1;
+      ++n;
+
+    }
+
+  }
+
+  if (!n) { return 0; }
+
+  memcpy(afl->stab_inter, afl->stab_cand, afl->fsrv.map_size);
+
+  for (u32 r = 0; r < afl->stab_repro_runs; ++r) {
+
+    void *use_mem = mem;
+    (void)write_to_testcase(afl, &use_mem, len, 1);
+    fsrv_run_result_t fault =
+        fuzz_run_target(afl, &afl->fsrv, afl->fsrv.exec_tmout);
+    ++afl->stab_gate_execs;
+
+    if (afl->stop_soon || fault != afl->crash_mode) {
+
+      ++afl->stab_rejected;
+      return 0;
+
+    }
+
+    u32 left = 0;
+    for (i = 0; i < afl->fsrv.map_size; ++i) {
+
+      if (afl->stab_inter[i]) {
+
+        if (!afl->fsrv.trace_bits[i]) {
+
+          afl->stab_inter[i] = 0;
+
+        } else {
+
+          ++left;
+
+        }
+
+      }
+
+    }
+
+    if (!left) {
+
+      ++afl->stab_rejected;
+      return 0;
+
+    }
+
+  }
+
+  for (i = 0; i < afl->fsrv.map_size; ++i) {
+
+    if (afl->stab_inter[i]) { afl->virgin_unstable[i] = 0; }
+
+  }
+
+  ++afl->stab_admitted;
+  return 1;
+
+}
