   if (!n) { return 0; }
 
+  /* Probabilistic admission: the more stable the run already is, the less
+     often we spend gate executions on unstable-only candidates. */
+  if (afl->stab_admit_m < 1.0) {
+
+    double stability = afl->last_stability / 100.0;
+    if (stability < 0.0) { stability = 0.0; }
+    if (stability > 1.0) { stability = 1.0; }
+
+    double probability = afl->stab_admit_m * (1.0 - stability);
+    if (probability <= 0.0) {
+
+      ++afl->stab_prob_skipped;
+      return 0;
+
+    }
+
+    if (probability < 1.0 &&
+        rand_below(afl, 1000000) >= (u32)(probability * 1000000.0)) {
+
+      ++afl->stab_prob_skipped;
+      return 0;
+
+    }
+
+  }
+
   memcpy(afl->stab_inter, afl->stab_cand, afl->fsrv.map_size);
 
   for (u32 r = 0; r < afl->stab_repro_runs; ++r) {
