 #if AFL_RTN_SUPPORTED
     if (!getenv("AFL_QEMU_CMPLOG_NO_RTN")) {
         libafl_add_block_hook(afl_cmplog_rtn_gen, NULL, afl_cmplog_rtn_exec, 0);
+        if (__afl_cmplog_dbg) {
+            fprintf(stderr, "[AFL] cmplog: RTN enabled\n");
+        }
+    } else if (__afl_cmplog_dbg) {
+        fprintf(stderr, "[AFL] cmplog: RTN disabled (AFL_QEMU_CMPLOG_NO_RTN)\n");
     }
