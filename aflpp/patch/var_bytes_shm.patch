+/* Unstable-edge mirror for afl-cassowire.
+ *
+ * afl->var_bytes is the bitmap calibration retires variable edges in. It lives
+ * only in the fuzzer's address space, so a proxy sitting between afl-fuzz and
+ * the target cannot see it. This publishes it in a SysV segment whose id is
+ * handed to the target environment as VARBYTES_SHM_ENV_VAR; the proxy
+ * shmat()s it and masks the corresponding edge ids out of its crash-dump
+ * history footprints. The segment is IPC_RMID'ed right after the attach, so it
+ * disappears when afl-fuzz and every attached proxy exit (no leftover segments
+ * after a SIGKILL). Best effort: on any failure the id stays -1 and the proxy
+ * falls back to its configured mask source. */
+
+static void afl_var_bytes_shm_destroy(afl_state_t *afl) {
+
+  if (afl->var_bytes_shm) {
+
+    shmdt(afl->var_bytes_shm);
+    afl->var_bytes_shm = NULL;
+
+  }
+
+  afl->var_bytes_shm_size = 0;
+  afl->var_bytes_shm_id = -1;
+  unsetenv(VARBYTES_SHM_ENV_VAR);
+
+}
+
+static void afl_var_bytes_shm_create(afl_state_t *afl, u32 size) {
+
+  afl_var_bytes_shm_destroy(afl);
+  if (!size) { return; }
+
+#if defined(__linux__)
+  int id = shmget(IPC_PRIVATE, size, IPC_CREAT | 0600);
+  if (id < 0) { return; }
+
+  void *map = shmat(id, NULL, 0);
+  if (map == (void *)-1) {
+
+    shmctl(id, IPC_RMID, NULL);
+    return;
+
+  }
+
+  /* Remove-on-close: the segment dies once afl-fuzz and every proxy detach. */
+  shmctl(id, IPC_RMID, NULL);
+
+  afl->var_bytes_shm = (u8 *)map;
+  afl->var_bytes_shm_size = size;
+  afl->var_bytes_shm_id = id;
+  memset(afl->var_bytes_shm, 0, size);
+
+  char id_str[32];
+  snprintf(id_str, sizeof(id_str), "%d", id);
+  setenv(VARBYTES_SHM_ENV_VAR, id_str, 1);
+#else
+  (void)afl;
+  (void)size;
+#endif
+
+}
