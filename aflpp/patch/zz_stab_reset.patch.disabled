+/* Naive full stability reset (AFL_STAB_RESET_EXECS): every N executions,
+   forget all retired variable edges, make them discoverable again, and put
+   them back into the instability gate channel. This is deliberately blunt:
+   it exists to measure whether periodic forgetting recovers transiently
+   unstable coverage or merely re-admits structural noise. */
+static void stab_maybe_reset(afl_state_t *afl) {
+
+  if (unlikely(!afl->stab_reset_execs)) { return; }
+  if (afl->fsrv.total_execs - afl->stab_last_reset_execs <
+      afl->stab_reset_execs) {
+
+    return;
+
+  }
+
+  afl->stab_last_reset_execs = afl->fsrv.total_execs;
+
+  u32 i, edges = 0;
+  for (i = 0; i < afl->fsrv.map_size; ++i) {
+
+    if (likely(!afl->var_bytes[i])) { continue; }
+
+    afl->var_bytes[i] = 0;
+    if (afl->var_bytes_shm) { afl->var_bytes_shm[i] = 0; }
+    afl->virgin_bits[i] = 0xff;
+    afl->virgin_reclaim[i] = 0;
+
+    if (afl->stab_admit_repro && !afl->virgin_unstable[i]) {
+
+      afl->virgin_unstable[i] = 0xff;
+      ++afl->virgin_unstable_count;
+
+    }
+
+    ++edges;
+
+  }
+
+  if (edges) {
+
+    afl->var_byte_count = count_bytes(afl, afl->var_bytes);
+    ++afl->stab_resets;
+    afl->stab_reset_edges += edges;
+    if (unlikely(afl->debug)) {
+
+      DEBUGF("stability reset at %llu execs: %u edges un-retired\n",
+             afl->fsrv.total_execs, edges);
+
+    }
+
+  }
+
+}
+
 u8 __attribute__((hot)) save_if_interesting(afl_state_t *afl, void *mem,
                                             u32 len, u8 fault) {
 
   if (unlikely(len == 0)) { return 0; }
 
+  stab_maybe_reset(afl);
+
   if (unlikely(fault == FSRV_RUN_TMOUT && afl->afl_env.afl_ignore_timeouts)) {
 
     if (unlikely(afl->schedule >= FAST && afl->schedule <= RARE)) {
@@ -1239,8 +1300,10 @@
       if (san_fault == FSRV_RUN_OK) {
 
         /* Instability-aware admission: no new stable coverage, but the input
-           reproduced edges that calibration retired as variable. */
-        if (unlikely(afl->stab_admit_repro && afl->var_byte_count) &&
+           reproduced edges that calibration retired as variable. Use the
+           gate-channel count rather than var_byte_count so a full reset does
+           not disable the gate. */
+        if (unlikely(afl->stab_admit_repro && afl->virgin_unstable_count) &&
             stab_repro_admit(afl, mem, len)) {
 
           new_bits |= NEW_BITS_STAB_MASK;
